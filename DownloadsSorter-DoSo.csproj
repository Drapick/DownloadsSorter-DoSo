<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- Отключает консольное окно Windows при старте (WinExe. Чтобы вернуть Exe просто)-->
        <OutputType>WinExe</OutputType> 
        <TargetFramework>net10.0-windows</TargetFramework>
        <RootNamespace>DownloadsSorter_DoSo</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <UseWindowsForms>true</UseWindowsForms>
        <ApplicationIcon>Resources\logo.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
        <!-- Content с CopyToPublishDirectory принудительно копирует картинки в папку publish -->
        <Content Include="Resources\**">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
            <CopyToPublishDirectory>Always</CopyToPublishDirectory>
        </Content>
    </ItemGroup>


</Project>
